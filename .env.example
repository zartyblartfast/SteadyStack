# =============================================================================
# SteadyStack — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=                        # Random secret for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
APP_DEBUG=true

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=steadystack
POSTGRES_USER=steadystack
POSTGRES_PASSWORD=

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- External APIs: Market Data ---
# CoinGecko (free tier — no key required, but rate-limited to ~30 req/min)
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Binance public API (no key required for market data)
BINANCE_API_URL=https://api.binance.com/api/v3

# mempool.space (no key required)
MEMPOOL_API_URL=https://mempool.space/api

# Bitcoin Card local metrics API (no hosted public API in v0.1.x)
BITCOIN_CARD_BASE_URL=http://127.0.0.1:8787

# --- Bitcoin: Electrum RPC (watch-only) ---
ELECTRUM_RPC_HOST=localhost
ELECTRUM_RPC_PORT=7777
ELECTRUM_RPC_USER=
ELECTRUM_RPC_PASSWORD=

# --- Notifications: Telegram ---
TELEGRAM_BOT_TOKEN=                    # From @BotFather
TELEGRAM_WEBHOOK_URL=                  # Public URL for webhook delivery

# --- Authentication: Lightning (LNURL-auth) ---
LNURL_AUTH_HOST=                       # Public hostname for LNURL callback

# --- Encryption ---
API_KEY_ENCRYPTION_KEY=                # Fernet key for encrypting exchange API keys at rest (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")

# --- Frontend ---
BACKEND_URL=http://localhost:8000          # Server-side: used by Next.js API proxy routes to reach the backend
NEXT_PUBLIC_API_URL=                       # Client-side: API base URL (leave empty to use same origin via BFF proxy)
